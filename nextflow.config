nextflow.enable.dsl = 2

plugins {
  id 'nf-schema@2.3.0'
}

// ----------------------
// Pipeline Parameters
// ----------------------
//
// illumina: fastqc + fastp/trimmomatic/trimgalore + megahit/metaspades + dnaapler/circlator + busco
// pacbio:   [BAM2FQ] + NanoPlot + hifiasm/flye + dnaapler/circlator + busco
// nanopore: [BAM2FQ] + NanoPlot + flye + dnaapler/circlator + mini_align + busco
// hybrid:   fastqc + fastp/trimmomatic/trimgalore (illumina) + [BAM2FQ] + NanoPlot (longreads) + unicycler + dnaapler/circlator + busco

params {
    // General options
    help                 = false
    outdir               = "./results"
    data_type            = "illumina" // illumina, pacbio, nanopore, hybrid
    samplesheet          = "./samplesheet.csv"
    
    // Hybrid-specific parameters
    longread_type        = null // Required for hybrid: pacbio or nanopore
    longread_format      = null // Required for pacbio/nanopore/hybrid: bam or fastq
    
    // ========================================
    // Tool selection
    // ========================================
    
    // Illumina
    illumina_trimmer     = "fastp"   // fastp (default), trimmomatic, trimgalore
    illumina_assembler   = "megahit" // megahit (default), metaspades 
    
    // Long reads
    pacbio_assembler     = "hifiasm" // hifiasm (default), flye
    flye_mode            = null      // e.g., "pacbio-raw", "pacbio-corr", "pacbio-hifi", "nano-raw", "nano-corr", "nano-hq"
    
    // Contig reorientation (shared across all workflows)
    reorientation_tool   = "dnaapler" // dnaapler (default), circlator
    
    // ========================================
    // Skip options
    // ========================================
    skip_qc              = false  // Skip QC steps (FastQC/NanoPlot)
    skip_trimming        = false  // Skip trimming for Illumina reads
    skip_polish          = false  // Skip polishing step
    skip_reorientation   = false  // Skip contig reorientation
    skip_busco           = false  // Skip BUSCO assessment
    
    // ========================================
    // Tool-specific parameters
    // ========================================
    
    // Trim Galore
    trimgalore_quality    = 20 // Default Phred score: 20
    trimgalore_stringency = 1  // Defaults to a very stringent setting of 1
    
    // MetaSPAdes
    metaspades_k         = 'auto'
    
    // Hifiasm
    hifiasm_k            = 51 // k-mer length (must be <64) [51]
    hifiasm_a            = 4  // round of assembly cleaning [4]

    // Unicycler (hybrid)
    unicycler_mode             = "normal" // conservative, normal, bold
    unicycler_min_fasta_length = 100      // default      

    // Circlator
    circlator_min_id     = 70
    
    // BUSCO
    busco_mode           = "genome"
    busco_lineage        = null    // e.g., "bacteria_odb10"

    // ========================================
    // Extra parameters for specific tools
    // ========================================
    fastp_opts           = ""
    trimgalore_opts      = ""
    trimmomatic_opts     = ""
    spades_opts          = ""
    megahit_opts         = ""
    fastqc_opts          = ""
    nanoplot_opts        = ""
    hifiasm_opts         = ""
    flye_opts            = ""
    busco_opts           = ""
    circlator_opts       = ""
    dnaapler_opts        = ""
    unicycler_opts       = ""
    filtlong_opts        = ""
}


// ----------------------
// Process Configuration
// ----------------------

process {
    container = 'singularity_image/assembly_pipe.sif'
    containerOptions = '--no-home'
    
    // Resource labels
    withLabel: 'io_limited' {
        cpus   = 4
        memory = 8.GB
        time   = '2h'
    }
    withLabel: 'io_limited_local' {
        cpus   = 2
        memory = 8.GB
        time   = '1h'
    }
    withLabel: 'io_net' {
        cpus   = 2
        memory = 8.GB
        time   = '4h'
    }
    withLabel: 'io_mem' {
        cpus   = 10
        memory = 16.GB
        time   = '4h'
    }
    withLabel: 'multithread' {
        cpus   = 20
        memory = 8.GB
        time   = '8h'
    }
    withLabel: 'mem_medium' {
        cpus   = 10
        memory = 16.GB
        time   = '4h'
    }
    withLabel: 'mem_veryhigh' {
        cpus   = 30
        memory = 64.GB
        time   = '24h'
    }
    
    // Error handling - retry with more resources
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2
    
    // Dynamic memory scaling on retry
    memory = { 
        def baseMemory = task.label?.contains('mem_veryhigh') ? 64.GB : 
                         task.label?.contains('mem_medium') ? 16.GB : 
                         task.label?.contains('io_mem') ? 16.GB : 8.GB
        baseMemory * Math.pow(2, task.attempt - 1)
    }
}

// ----------------------
// Execution Profiles
// ----------------------

profiles {
    standard {
        process.executor = 'local'
    }
    
    cluster {
        process {
            executor       = 'lsf'
            queue          = 'standard'
            clusterOptions = '-P prokasm'
        }
    }
    
    slurm {
        process {
            executor = 'slurm'
            queue    = 'normal'
        }
    }
    
    test {
        params {
            outdir       = "./test_results"
            max_cpus     = 2
            max_memory   = '6.GB'
            max_time     = '1.h'
        }
        process {
            memory = { check_max( 4.GB * task.attempt, 'memory' ) }
            cpus   = { check_max( 2, 'cpus' ) }
            time   = { check_max( 30.min * task.attempt, 'time' ) }
        }
    }
    
    debug {
        process.beforeScript = 'echo "Starting process..."'
        cleanup = false
    }
}

// ----------------------
// Container Engines
// ----------------------

singularity {
    enabled    = true
    autoMounts = true
    runOptions = '--no-mount /programs'
    cacheDir   = "${projectDir}/.singularity_cache"
}

// Conda can be used as fallback
conda.enabled = true

// Docker alternative (disabled by default)
docker {
    enabled = false
}

// ----------------------
// Report Configuration
// ----------------------

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

// ----------------------
// Manifest
// ----------------------

manifest {
    name            = 'prokasm'
    author          = 'Qidong Jia'
    homePage        = ''
    description     = 'Modular Nextflow DSL2 pipeline for de novo bacterial genome assembly from Illumina, PacBio, and Nanopore data'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=23.10.0'
    version         = '1.1.0'
    doi             = ''
}
